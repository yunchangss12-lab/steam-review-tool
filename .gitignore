# ===== 敏感凭证（严禁入库）=====
config.local.json
*.key
.env
secrets.json
api_key.txt

# 例外：安装器内的 config 模板（空的，不含真实密钥）需要入库
!installer/config.local.json

# ===== 抓取到的数据（含用户/客户数据，严禁入库）=====
data/
output/
reports/
*.review.json
*.cache.json

# ===== 打包产物与二进制 =====
dist/
build/
*.exe
*.dll
*.pyd
*.so

# ===== 运行态与临时文件 =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.log
.DS_Store
